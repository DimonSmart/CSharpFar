<Project>
  <!-- CSharpFar application release metadata must never override the stable binary
       identity of the public plugin contract assemblies. -->
  <PropertyGroup Condition="'$(CSharpFarReleaseVersion)' != '' and
                            ('$(MSBuildProjectName)' == 'CSharpFar.Host.Windows' or
                             '$(MSBuildProjectName)' == 'CSharpFar.Host.Linux' or
                             '$(MSBuildProjectName)' == 'CSharpFar.Host.MacOs')">
    <Version>$(CSharpFarReleaseVersion)</Version>
    <AssemblyVersion>$(CSharpFarReleaseVersion).0</AssemblyVersion>
    <FileVersion>$(CSharpFarReleaseVersion).0</FileVersion>
    <InformationalVersion>v$(CSharpFarReleaseVersion)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <HuskyRoot Condition="'$(HuskyRoot)' == ''">$(MSBuildThisFileDirectory)</HuskyRoot>
  </PropertyGroup>

  <Target Name="Husky"
          AfterTargets="Restore"
          Condition="'$(HUSKY)' != '0' and Exists('$(HuskyRoot).config/dotnet-tools.json') and Exists('$(HuskyRoot).git')"
          Inputs="$(HuskyRoot).config/dotnet-tools.json"
          Outputs="$(HuskyRoot).husky/_/install.stamp">
    <Exec Command="dotnet tool restore"
          WorkingDirectory="$(HuskyRoot)"
          StandardOutputImportance="Low"
          StandardErrorImportance="High" />
    <Exec Command="dotnet husky install"
          WorkingDirectory="$(HuskyRoot)"
          StandardOutputImportance="Low"
          StandardErrorImportance="High" />
    <Touch Files="$(HuskyRoot).husky/_/install.stamp"
           AlwaysCreate="true"
           Condition="Exists('$(HuskyRoot).husky/_')" />
    <ItemGroup>
      <FileWrites Include="$(HuskyRoot).husky/_/install.stamp" />
    </ItemGroup>
  </Target>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(CSharpFarDevelopmentExtensionId)' != ''">
    <!-- A deleted staged copy must be restored by the next Visual Studio build. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <!-- Repository development deployment only; independent SDK/release packaging is unchanged. -->
  <Target Name="StageDevelopmentExtension" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' and '$(CSharpFarDevelopmentExtensionId)' != '' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_DevelopmentHost Include="$(MSBuildThisFileDirectory)src/CSharpFar.Host.Windows;$(MSBuildThisFileDirectory)src/CSharpFar.Host.Linux;$(MSBuildThisFileDirectory)src/CSharpFar.Host.MacOs" />
      <_DevelopmentFile Include="$(TargetDir)**/*"
                        Exclude="$(TargetDir)CSharpFar.Core.*;$(TargetDir)CSharpFar.Plugin.Abstractions.*" />
    </ItemGroup>
    <!-- These are build-owned directories, never the user configuration directory. -->
    <PropertyGroup>
      <_DevelopmentHostSuffix>bin/$(Configuration)/$(TargetFramework)/development-extensions/$(CSharpFarDevelopmentExtensionId)</_DevelopmentHostSuffix>
    </PropertyGroup>
    <RemoveDir Directories="@(_DevelopmentHost->'%(FullPath)/$(_DevelopmentHostSuffix)')" />
    <Copy SourceFiles="@(_DevelopmentFile)"
          DestinationFiles="@(_DevelopmentFile->'$(MSBuildThisFileDirectory)src/CSharpFar.Host.Windows/$(_DevelopmentHostSuffix)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_DevelopmentFile)"
          DestinationFiles="@(_DevelopmentFile->'$(MSBuildThisFileDirectory)src/CSharpFar.Host.Linux/$(_DevelopmentHostSuffix)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_DevelopmentFile)"
          DestinationFiles="@(_DevelopmentFile->'$(MSBuildThisFileDirectory)src/CSharpFar.Host.MacOs/$(_DevelopmentHostSuffix)/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CleanDevelopmentExtension" AfterTargets="Clean"
          Condition="'$(Configuration)' == 'Debug' and '$(CSharpFarDevelopmentExtensionId)' != ''">
    <ItemGroup>
      <_StagedDevelopmentExtension Include="$(MSBuildThisFileDirectory)src/CSharpFar.Host.Windows;$(MSBuildThisFileDirectory)src/CSharpFar.Host.Linux;$(MSBuildThisFileDirectory)src/CSharpFar.Host.MacOs" />
    </ItemGroup>
    <RemoveDir Directories="@(_StagedDevelopmentExtension->'%(FullPath)/bin/$(Configuration)/$(TargetFramework)/development-extensions/$(CSharpFarDevelopmentExtensionId)')" />
  </Target>
</Project>
