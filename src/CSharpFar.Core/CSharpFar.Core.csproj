<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/PluginSdk.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>CSharpFar.Core</PackageId>
    <Version>$(PluginSdkVersion)</Version>
    <AssemblyVersion>$(PluginSdkAssemblyVersion)</AssemblyVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>DimonSmart</Authors>
    <Description>Core public models and interfaces used by CSharpFar plugins.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DimonSmart/CSharpFar</RepositoryUrl>
    <PackageTags>CSharpFar;plugins;SDK</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpFar.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
