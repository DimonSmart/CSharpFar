<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CSharpFar.Console\CSharpFar.Console.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpFar.Ui.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>CSharpFar.Ui</PackageId>
    <Version>0.1.0</Version>
    <Title>CSharpFar.Ui</Title>
    <Description>Reusable console UI components, dialogs, forms, lists, menus and composition runtime.</Description>
    <Authors>CSharpFar contributors</Authors>
    <RepositoryUrl>https://github.com/DimonSmart/CSharpFar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>console;terminal;ui;dialogs</PackageTags>
    <IsPackable>true</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
