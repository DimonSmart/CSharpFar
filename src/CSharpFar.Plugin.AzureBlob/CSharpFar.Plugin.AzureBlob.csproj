<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CSharpFarDevelopmentExtensionId Condition="'$(AzureBlobBinarySdk)' != 'true'">azure-blob</CSharpFarDevelopmentExtensionId>
  </PropertyGroup>
  <ItemGroup Condition="'$(AzureBlobBinarySdk)' != 'true'">
    <ProjectReference Include="../CSharpFar.Plugin.Abstractions/CSharpFar.Plugin.Abstractions.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(AzureBlobBinarySdk)' == 'true'">
    <PackageReference Include="CSharpFar.Plugin.Abstractions" Version="2.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="CSharpFar.Core" Version="2.1.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
