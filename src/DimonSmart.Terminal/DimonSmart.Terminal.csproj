<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/TerminalPackages.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>DimonSmart.Terminal</PackageId>
    <Version>$(TerminalVersion)</Version>
    <Title>DimonSmart.Terminal</Title>
    <Description>Platform-neutral .NET terminal runtime abstractions.</Description>
    <Authors>DimonSmart</Authors>
    <RepositoryUrl>https://github.com/DimonSmart/CSharpFar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>console;terminal;runtime;cross-platform</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CSharpFar.Console/CSharpFar.Console.csproj" PrivateAssets="all" />
    <None Include="../../docs/terminal-packages-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="../CSharpFar.Console/bin/$(Configuration)/$(TargetFramework)/CSharpFar.Console.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" />
  </ItemGroup>
</Project>
