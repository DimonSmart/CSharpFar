<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/TerminalPackages.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>DimonSmart.Terminal.Ansi</PackageId>
    <Version>$(TerminalVersion)</Version>
    <Title>DimonSmart.Terminal.Ansi</Title>
    <Description>ANSI terminal backend for Linux and macOS.</Description>
    <Authors>DimonSmart</Authors>
    <RepositoryUrl>https://github.com/DimonSmart/CSharpFar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>console;terminal;ansi;linux;macos</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CSharpFar.Console.Ansi/CSharpFar.Console.Ansi.csproj" PrivateAssets="all" />
    <PackageReference Include="DimonSmart.Terminal" Version="$(TerminalVersion)" />
    <None Include="../../docs/terminal-packages-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="../CSharpFar.Console.Ansi/bin/$(Configuration)/$(TargetFramework)/CSharpFar.Console.Ansi.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" />
  </ItemGroup>
</Project>
