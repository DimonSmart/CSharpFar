<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>CSharpFar.Console</PackageId>
    <Version>0.1.0</Version>
    <Title>CSharpFar.Console</Title>
    <Description>Low-level console abstractions used by the CSharpFar terminal UI stack.</Description>
    <Authors>CSharpFar contributors</Authors>
    <RepositoryUrl>https://github.com/DimonSmart/CSharpFar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>console;terminal;ui</PackageTags>
    <IsPackable>true</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpFar.Console.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpFar.Console.Ansi</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpFar.Console.Ansi.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpFar.Console.Windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
