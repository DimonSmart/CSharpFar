<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/PluginSdk.props" />

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpFar.Core\CSharpFar.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>CSharpFar.Plugin.Abstractions</PackageId>
    <Version>$(PluginSdkVersion)</Version>
    <AssemblyVersion>$(PluginSdkAssemblyVersion)</AssemblyVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>DimonSmart</Authors>
    <Description>Public contracts for native CSharpFar plugins.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DimonSmart/CSharpFar</RepositoryUrl>
    <PackageTags>CSharpFar;plugins;SDK</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
